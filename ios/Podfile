# Firebase's iOS pods (pulled in by firebase_messaging — a cross-platform plugin,
# though iOS itself uses raw APNs) require iOS 15+. Set the floor here; also set
# the Runner + NotificationService deployment targets to 15.0 in Xcode.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# Mantle Push — the Notification Service Extension links libsodium (swift-sodium)
# to open the sealed box. STATIC linkage is required: with the default dynamic
# `use_frameworks!`, swift-sodium builds a dynamic `Sodium.framework` (capital S)
# that case-collides with the Dart `sodium` 4.x native-asset `sodium.framework`
# (lowercase) on case-insensitive macOS — Runner then links `Sodium.framework`,
# which doesn't exist on the case-sensitive device, so the app SIGABRTs at launch.
# Static linkage emits no dynamic framework, so there's nothing to collide.
target 'NotificationService' do
  use_frameworks! :linkage => :static
  pod 'Sodium', '~> 0.9.1'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Disable dSYM generation for pods. The Flutter native-assets build (sodium
      # 4.x) already emits duplicate dSYMs, and the Sodium CocoaPod's dSYM collides
      # during `xcodebuild archive` ("Sodium.framework.dSYM … already exists").
      # dwarf (no .dSYM) avoids all of it; cost is no crash symbolication. See memory.
      config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf'
    end
  end
end
